rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Catalog assets read by the mobile apps (MVP + V2)
    match /model/{fileName} {
      allow read: if signedIn();
    }
    match /pics/{fileName} {
      allow read: if signedIn();
    }

    match /partner_uploads/{businessId}/{submissionId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.size < 100 * 1024 * 1024
        && (fileName.matches('.*\\.glb$') || fileName == 'thumbnail.png');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
